# ---------------------------------------------------------------------------
# Copy to .env and adjust. Every service reads this file via support_common.config.
# Values here are the local-development defaults used by docker-compose.
# ---------------------------------------------------------------------------

# --- General ----------------------------------------------------------------
ENVIRONMENT=local                 # local | ci | staging | production
LOG_LEVEL=INFO                    # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json                   # json | console

# --- PostgreSQL -------------------------------------------------------------
POSTGRES_USER=support
POSTGRES_PASSWORD=support
POSTGRES_DB=support
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
# Async driver (services). Alembic derives the sync URL automatically.
# Port 5433 matches docker-compose, which avoids clashing with a Postgres
# already installed on the host. Override with POSTGRES_HOST_PORT.
DATABASE_URL=postgresql+asyncpg://support:support@localhost:5433/support
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# --- Redis ------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=3600

# --- Ollama (local LLM, no API key required) --------------------------------
OLLAMA_HOST=http://localhost:11434
# Any tool-calling capable local model: qwen3:8b, mistral, llama3.1:8b, nemotron-mini
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_NUM_CTX=8192
OLLAMA_TEMPERATURE=0.1
# Set true to keep the model resident in VRAM between requests (lower latency).
OLLAMA_KEEP_ALIVE=30m

# --- Embeddings -------------------------------------------------------------
# sentence_transformers -> local CPU model, 384-dim, no daemon needed
# ollama                -> reuses the Ollama daemon (nomic-embed-text, 768-dim)
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_BATCH_SIZE=64

# --- Vector store -----------------------------------------------------------
VECTOR_BACKEND=chroma             # chroma | pinecone
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION=support_kb
# Only used when VECTOR_BACKEND=pinecone
PINECONE_API_KEY=
PINECONE_INDEX=support-kb
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# --- Knowledge base ---------------------------------------------------------
KB_DIR=./support-kb
KB_CHUNK_SIZE=900                 # characters per chunk
KB_CHUNK_OVERLAP=150
RAG_TOP_K=5
RAG_MIN_SCORE=0.25                # cosine similarity floor for a usable hit

# --- Service URLs (in-cluster names differ; see kubernetes/) -----------------
TICKET_RECEIVER_URL=http://localhost:8001
RAG_ENGINE_URL=http://localhost:8002
AGENT_URL=http://localhost:8003
DISPATCHER_URL=http://localhost:8004
HTTP_TIMEOUT_SECONDS=30
HTTP_MAX_RETRIES=3

# --- Ticket receiver ---------------------------------------------------------
# Concurrent background tickets processed at once, out of the shared Postgres
# pool (DB_POOL_SIZE + DB_MAX_OVERFLOW). Excess tickets queue on this rather
# than every one of them grabbing a connection and starving foreground reads.
PIPELINE_MAX_CONCURRENCY=10

# --- Agent behaviour --------------------------------------------------------
AGENT_MAX_TURNS=5
AGENT_CONFIDENCE_THRESHOLD=0.70   # below this the ticket is escalated to a human
AGENT_MAX_CONCURRENCY=8           # in-flight LLM calls per agent replica

# --- Dispatcher channels ----------------------------------------------------
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_DEFAULT_CHANNEL=#support
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_FROM_EMAIL=support@example.com
SMTP_FROM_NAME=Acme Support
# Leave empty to disable outbound delivery and only log (safe default for dev).
DISPATCH_DRY_RUN=true

# --- Inbound auth -----------------------------------------------------------
# Shared secret required in the X-API-Key header on public ingest endpoints.
API_KEY=dev-local-key
ZENDESK_WEBHOOK_SECRET=

# --- Observability ----------------------------------------------------------
METRICS_ENABLED=true
